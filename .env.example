# FloorPulse — ERPNext Docker Environment
# =========================================
# Copy to .env and fill in your values before running `make install`

# Docker image configuration
CUSTOM_IMAGE=floorpulse-erpnext
CUSTOM_TAG=v15
PULL_POLICY=missing

# ERPNext / Frappe version
FRAPPE_VERSION=version-15

# Database
DB_PASSWORD=ChangeMe_StrongPassword_123!

# Site
SITE_NAME=floorpulse.localhost
ADMIN_PASSWORD=ChangeMe_Admin_123!

# Port exposed on the host
HTTP_PUBLISH_PORT=8080
